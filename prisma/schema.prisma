datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. ユーザーテーブル
model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  role            String           @default("employee") // admin, manager, employee
  azureOid        String?          @map("azure_oid")
  
  // ▼ 追加：上司のユーザーID（自己参照）
  managerId       String?          @map("manager_id")
  manager         User?            @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates    User[]           @relation("ManagerSubordinates")

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  attendances     Attendance[]
  leaveRequests   LeaveRequest[]
  paidLeaveGrants PaidLeaveGrant[]
  correctionRequests AttendanceCorrectionRequest[]

  @@map("users")
}

// 2. 勤怠・打刻テーブル
model Attendance {
  id           String    @id @default(uuid())
  userId       String
  workDate     DateTime  // 年月日（00:00:00）
  clockInTime  DateTime? // 出勤時刻
  clockInLat   Decimal?
  clockInLng   Decimal?
  clockOutTime DateTime? // 退勤時刻
  clockOutLat  Decimal?
  clockOutLng  Decimal?
  breakMinutes Int       @default(0)
  workMinutes  Int       @default(0)
  status       String    @default("working")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  siteId        String?   @map("site_id")
  site          Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks Break[]
  correctionRequests AttendanceCorrectionRequest[]

  @@unique([userId, workDate])
}

// 3. 休憩履歴テーブル
model Break {
  id           String     @id @default(uuid())
  attendanceId String     @map("attendance_id")
  breakStart   DateTime   @map("break_start")
  breakEnd     DateTime?  @map("break_end")
  isAuto       Boolean    @default(false) @map("is_auto")
  createdAt    DateTime   @default(now()) @map("created_at")

  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@map("breaks")
}

// 4. 休暇申請テーブル
model LeaveRequest {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  leaveType    String   @map("leave_type") // paid, half_am, half_pm, special
  startDate    DateTime @db.Date @map("start_date")
  endDate      DateTime @db.Date @map("end_date")
  reason       String?
  status       String   @default("pending") // pending, approved, rejected
  approverId   String?  @map("approver_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

// 5. 打刻修正申請テーブル
model AttendanceCorrectionRequest {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  attendanceId    String?      @map("attendance_id") // 既存の打刻があれば紐付け
  targetDate      DateTime     @db.Date @map("target_date") // 修正対象の年月日
  
  // 変更したい希望の時刻・内容
  newClockInTime  DateTime?    @map("new_clock_in_time")
  newClockOutTime DateTime?    @map("new_clock_out_time")
  newBreakMinutes Int?         @map("new_break_minutes")
  
  reason          String       // 修正理由
  status          String       @default("pending") // pending (承認待ち), approved (承認), rejected (否認)
  approverId      String?      @map("approver_id") // 承認したマネージャー/管理者のID
  
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance      Attendance?  @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@map("attendance_correction_requests")
}

model PaidLeaveGrant {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  grantDate    DateTime  @db.Date @map("grant_date")     // 付与日
  expiredDate  DateTime  @db.Date @map("expired_date")   // 失効日（通常付与から2年）
  daysGranted  Float     @map("days_granted")            // 付与日数（例: 10日、12日など）
  daysUsed     Float     @default(0) @map("days_used")   // 消化日数
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("paid_leave_grants")
}

// 現場・勤務地マスタ
model Site {
  id          String   @id @default(uuid())
  name        String   // 現場名（例: 「〇〇ビル測量現場」「A社 敷地調査」など）
  address     String?  // 住所（任意）
  latitude    Float?   // 緯度（将来のジオフェンス用）
  longitude   Float?   // 経度（将来のジオフェンス用）
  radiusMeter Int      @default(100) @map("radius_meter") // 許容半径（メートル）
  isActive    Boolean  @default(true) @map("is_active") // 表示・非表示（true: 表示, false: 非表示）
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  attendances Attendance[] // どの現場で打刻したか紐付ける場合

  @@map("sites")
}