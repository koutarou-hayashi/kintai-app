datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. ユーザーテーブル
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  role          String   @default("employee") // admin, manager, employee
  azureOid      String?  @map("azure_oid")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  attendances   Attendance[]
  leaveRequests LeaveRequest[]

  @@map("users")
}

// 2. 勤怠・打刻テーブル
model Attendance {
  id           String    @id @default(uuid())
  userId       String
  workDate     DateTime  // 年月日（00:00:00）
  clockInTime  DateTime? // 出勤時刻
  clockInLat   Decimal?
  clockInLng   Decimal?
  clockOutTime DateTime? // 退勤時刻
  clockOutLat  Decimal?
  clockOutLng  Decimal?
  breakMinutes Int       @default(0)
  workMinutes  Int       @default(0)
  status       String    @default("working")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks Break[]

  @@unique([userId, workDate])
}

// 3. 休憩履歴テーブル
model Break {
  id           String     @id @default(uuid())
  attendanceId String     @map("attendance_id")
  breakStart   DateTime   @map("break_start")
  breakEnd     DateTime?  @map("break_end")
  isAuto       Boolean    @default(false) @map("is_auto")
  createdAt    DateTime   @default(now()) @map("created_at")

  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@map("breaks")
}

// 4. 休暇申請テーブル
model LeaveRequest {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  leaveType    String   @map("leave_type") // paid, half_am, half_pm, special
  startDate    DateTime @db.Date @map("start_date")
  endDate      DateTime @db.Date @map("end_date")
  reason       String?
  status       String   @default("pending") // pending, approved, rejected
  approverId   String?  @map("approver_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}